#!/sbin/sh
# Rebler - updater-script
# Unused by Magisk/KSU/APatch (they call update-binary with their own
# arguments). Kept so TWRP-style recoveries can find the installer.
assert(package_extract_file("META-INF/com/google/android/update-binary", "/tmp/update-binary"));
set_progress(1);
ui_print("Rebler installation starting...");